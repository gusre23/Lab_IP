while True:
    opcion = input("Elige A, B o C:").strip().upper()
# strip() elimina espacios en blanco al inicio y final de una cadena de texto
# upper() convierte a mayúsculas la cadena de texto
    if opcion in ("A", "B", "C"):
        break

    print("Opción inválida. Intenta de nuevo.")

print(f"Elegiste (opcion)")