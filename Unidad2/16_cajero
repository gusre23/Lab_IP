def consultar_saldo():  # def sirve para crear funciones
    print("Saldo: $0.00")
def depositar():
    print("Depósito realizado")
def retirar():
    print("Retiro realizado")
def salir():
    print("Saliendo del cajero automático...")


def mostrar_menu():
    print("-----------------------------------")
    print("Bienvenido al cajero automático")
    print("1. Consultar saldo")
    print("2. Depositar")
    print("3. Retirar")
    print("4. Salir")
    print("------------------------------------")
    return input("Opción: ").strip()

def main():   # Esta función programa cuál de las funciones llama al introducir cada número, es la primera que se ejecuta (línea 35)
    while True:
        opcion = mostrar_menu()  # Esta función llama a que se impriman las opciones del menú del cajero
        if opcion == "1":
            consultar_saldo()
        elif opcion == "2":
            depositar()
        elif opcion == "3":
            retirar()
        elif opcion == "4":
            salir()
            break
        else:
            print("Opción inválida")
main()