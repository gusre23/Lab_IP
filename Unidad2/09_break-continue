for numero in [4, 7, 9, 12]:
    if numero == 9:
        break  # Break detiene el proceso al encontrar el valor buscado
    print("con break", numero)

for numero in [4, 7, 9, 12]:
    if numero == 9:
        continue  # Continue se salta los valores indicados, no lo(s) procesa, y va al siguiente
    print("con continue", numero)